# Reproducible ETSI TTCN-3 CI inputs.
#
# ETSI TS.ITS 0b447bc2 is the Release-2 tree whose AtsBTP submodule is
# 3576386312f9dff1afcccc8f96247876ab9a0865, matching the retained validation
# evidence in docs/idf/validation.md.
ETSI_TS_ITS_COMMIT=0b447bc2e099498990183099792bd457adc5c744

# Retained successful campaigns in docs/idf/evidence were executed with TITAN
# 10.1.2. Keep the CI compiler/runtime on that release until deliberately
# revalidated against a newer TITAN version.
TITAN_REF=10.1.2
